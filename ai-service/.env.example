# Generate a random key locally; share only with Laravel's server environment.
AI_SERVICE_API_KEY=
FACE_MODEL_NAME=buffalo_m
# Absolute optional override; default is ai-service/.models
# FACE_MODEL_ROOT=C:/private/facetrack-models
AI_HEALTH_REQUESTS_PER_MINUTE=60
AI_EXTRACT_REQUESTS_PER_MINUTE=30
AI_MAX_IMAGE_BYTES=5242880
AI_MAX_IMAGE_SIDE=4096
AI_MAX_IMAGE_PIXELS=12000000
AI_BODY_TIMEOUT=10
# Uncalibrated quality heuristics; evaluate on consenting participants.
FACE_MIN_SIZE=80
FACE_MIN_DETECTION_SCORE=0.6
FACE_MIN_BLUR_VARIANCE=50
FACE_MIN_BRIGHTNESS=40
FACE_MAX_BRIGHTNESS=215
